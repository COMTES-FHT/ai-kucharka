def first(value: Any, default: Any = "") -> Any:

    if isinstance(value, list):

        return value[0] if value else default

    if value is None:

        return default

    return value

def safe(value: str) -> str:

    return re.sub(

        r"[^A-Za-z0-9]+",

        "_",

        str(value),

    ).strip("_")

def stable_id(seed: str) -> str:

    return hashlib.sha1(

        seed.encode("utf-8")

    ).hexdigest()[:24]

def detect_year(order_number: str) -> int:

    match = re.search(

        r"/(\d{2})/",

        order_number,

    )

    if not match:

        raise ValueError(

            f"Nelze určit rok z order_number: {order_number}"

        )

    return 2000 + int(match.group(1))

def number_or_text(value: Any) -> Any:

    if value is None:

        return None

    if isinstance(

        value,

        (int, float, bool),

    ):

        return value

    text = str(value).strip()

    if re.fullmatch(

        r"-?\d+(?:[,.]\d+)?",

        text,

    ):

        number = float(

            text.replace(",", ".")

        )

        if number.is_integer():

            return int(number)

        return number

    return text

def attr(

    property_name: str,

    value: Any,

    unit: str | None = None,

    **extra: Any,

) -> dict[str, Any]:

    result = {

        "property": property_name,

        "value": value,

    }

    if unit:

        result["unit"] = unit

    result.update(extra)

    return result

def get_value(

    row: dict[str, Any],

    possible_keys: tuple[str, ...],

):

    for key in possible_keys:

        if key in row:

            return True, row[key]

    return False, None

# ============================================================

# REPORT NUMBER

# ============================================================

def get_report_numbers(

    header: dict[str, Any],

):

    value = header.get(

        "report_number",

        [],

    )

    if not isinstance(value, list):

        value = [value]

    result = []

    for item in value:

        text = str(item)

        found = re.findall(

            r"APR\d+",

            text,

            flags=re.IGNORECASE,

        )

        if found:

            result.extend(found)

        elif text.strip():

            result.append(

                text.strip()

            )

    return list(

        dict.fromkeys(

            x.upper()

            for x in result

            if x

        )

    )

