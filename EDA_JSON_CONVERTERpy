def add_test_code_heat_attributes(

    order_attributes,

    header,

):

    pairs = header.get(

        "test_code_heat_number"

    )

    if not isinstance(

        pairs,

        list,

    ):

        return

    if not pairs:

        return

    test_codes = [

        str(

            item.get(

                "test_code",

                "",

            )

        ).strip()

        for item in pairs

        if item.get(

            "test_code"

        )

    ]

    heat_numbers = [

        str(

            item.get(

                "heat_number",

                "",

            )

        ).strip()

        for item in pairs

        if item.get(

            "heat_number"

        )

    ]

    if (

        test_codes

        and not any(

            a["property"] == "Test code"

            for a in order_attributes

        )

    ):

        order_attributes.append(

            attr(

                "Test code",

                "; ".join(

                    test_codes

                ),

                valuetype="string",

            )

        )

    if (

        heat_numbers

        and not any(

            a["property"] == "Heat number"

            for a in order_attributes

        )

    ):

        order_attributes.append(

            attr(

                "Heat number",

                "; ".join(

                    dict.fromkeys(

                        heat_numbers

                    )

                ),

                valuetype="string",

            )

        )

