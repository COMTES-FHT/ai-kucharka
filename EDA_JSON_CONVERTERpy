def create_linktable(

    itemid,

    section,

    property_name,

    linkval,

    linkkey="link_id",

    inherit=None,

):

    obj = {

        "type":

            "linktable",

        "sectags": [

            section

        ],

        "property":

            property_name,

        "linkval":

            linkval,

        "linkkey":

            linkkey,

        "itemid":

            itemid,

        "visible_":

            "all",

        "permission_group":

            "allreadonly",

        "child_":

            True,

        "version":

            1,

        "view_id": [

            itemid

        ],

    }

    if inherit:

        obj["inherit_"] = inherit

    return obj

