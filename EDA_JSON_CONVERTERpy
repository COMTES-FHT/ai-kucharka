    print(f"JSON input : {INPUT_DIR}")
    print(f"PDF folder : {PDF_DIR}")
    print(f"Output     : {OUTPUT_DIR}")
    print()

    # Diagnostika vstupních složek.
    print(f"INPUT_DIR exists: {'ANO' if INPUT_DIR.exists() else 'NE'}")
    print(f"PDF_DIR exists  : {'ANO' if PDF_DIR.exists() else 'NE'}")

