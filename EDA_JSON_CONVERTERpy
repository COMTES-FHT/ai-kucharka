def convert_file(

    source_path: Path,

    output_path: Path,

):

    raw = json.loads(

        source_path.read_text(

            encoding="utf-8-sig"

        )

    )

    if (

        not isinstance(raw, list)

        or len(raw) != 1

    ):

        raise ValueError(

            "Očekávám univerzální JSON "

            "jako list s jedním záznamem."

        )

    record = raw[0]

    header = record.get(

        "header",

        {},

    )

    methods = record.get(

        "methods",

        [],

    )

    tests = record.get(

        "tests",

        {},

    )

    customer_requirement = (

        record.get(

            "customer_requirement"

        )

    )

    # ========================================================

    # LAB ORDER

    # ========================================================

    order_number = str(

        first(

            header.get(

                "order_number"

            )

        )

    ).strip()

    if not order_number:

        raise ValueError(

            "Chybí order_number."

        )

    report_numbers = (

        get_report_numbers(

            header

        )

    )

    year = detect_year(

        order_number

    )

    folder_id = (

        CPF_YEAR_FOLDER_IDS.get(

            year

        )

    )

    if not folder_id:

        raise ValueError(

            f"Pro rok {year} není "

            "definované EDA folder itemid."

        )

    order_safe = safe(

        order_number

    )

    prefix = (

        f"cpf:{order_safe}"

    )

    order_id = stable_id(

        f"{prefix}:order"

    )

    test_series_table_id = (

        stable_id(

            f"{prefix}:test-series-table"

        )

    )

    all_tests_table_id = (

        stable_id(

            f"{prefix}:all-tests-table"

        )

    )

    children = [

        test_series_table_id,

        all_tests_table_id,

    ]

    # ========================================================

    # HLAVICKA LAB ORDERU

    # ========================================================

    order_attributes = []

    for (

        property_name,

        key

    ) in HEADER_PROPERTIES:

        if key in header:

            order_attributes.append(

                attr(

                    property_name,

                    first(

                        header[key]

                    ),

                    valuetype="string",

                )

            )

    add_test_code_heat_attributes(

        order_attributes,

        header,

    )

    objects = []

    objects.append(

        {

            "itemid":

                order_id,

            "type":

                "generic_order",

            "treetags": [

                folder_id,

                "toplevel",

                "all",

            ],

            "viewtags": [

                "_generic"

            ],

            "name":

                order_number,

            "attributes":

                order_attributes,

            "link_id":

                f"dfe:{order_safe}:lab_order",

            "visible_":

                "all",

            "permission_group":

                "allreadonly",

            "toplevel_":

                True,

            "linkval": [

                f"ts:{order_id}"

            ],

            "children":

                children,

            "version":

                1,

            "view_id": [

                order_id

            ],

        }

    )

    # ========================================================

    # TEST SERIES / ALL TESTS TABULKY

    # ========================================================

    objects.append(

        create_linktable(

            test_series_table_id,

            "Tests",

            "Test Series",

            f"dfe:{order_safe}:test_series",

            inherit="generic:testseries",

        )

    )

    objects.append(

        create_linktable(

            all_tests_table_id,

            "Tests",

            "All Tests",

            f"dfe:{order_safe}:all_tests",

            inherit="generic:alltests",

        )

    )

    # ========================================================

    # PDF REPORTS

    # ========================================================

    matched_pdfs = []

    missing_reports = []

    for report_number in report_numbers:

        pdf_files = (

            find_pdfs(

                report_number

            )

        )

        if not pdf_files:

            missing_reports.append(

                report_number

            )

            continue

        for pdf_name in pdf_files:

            if (

                pdf_name

                in matched_pdfs

            ):

                continue

            matched_pdfs.append(

                pdf_name

            )

            pdf_linktable_id = (

                stable_id(

                    f"{prefix}:"

                    f"pdf:{pdf_name}"

                )

            )

            children.append(

                pdf_linktable_id

            )

            objects.append(

                create_linktable(

                    pdf_linktable_id,

                    "Documents",

                    "PDF Reports",

                    pdf_name,

                    linkkey="name",

                )

            )

    # ========================================================

    # TEST SERIES + TESTY

    # ========================================================

    created_series = []

    test_count = 0

    for (

        series_key,

        series_label

    ) in SERIES.items():

        rows = (

            tests.get(

                series_key

            )

            or []

        )

        # Pokud dany typ zkousky

        # neexistuje, serii nevytvarime.

        if not rows:

            continue

        series_id = stable_id(

            f"{prefix}:"

            f"{series_key}:series"

        )

        tests_table_id = stable_id(

            f"{prefix}:"

            f"{series_key}:tests-table"

        )

        summary_id = stable_id(

            f"{prefix}:"

            f"{series_key}:summary"

        )

        test_link = (

            f"dfe:{order_safe}:"

            f"{series_key}:tests"

        )

        series_name = (

            f"{order_number} - "

            f"{series_label}"

        )

        method = (

            method_for_series(

                methods,

                series_key,

            )

        )

        # ====================================================

        # ATRIBUTY TEST SERIES

        # ====================================================

        series_attributes = [

            # KLIKACI LAB ORDER

            attr(

                "Lab Order",

                order_number,

                type="dblink",

                linkkey="name",

            ),

            attr(

                "Test Type",

                series_label,

            ),

            attr(

                "Method",

                method.get(

                    "name",

                    ""

                ),

            ),

            attr(

                "Method Identification",

                method.get(

                    "identification",

                    ""

                ),

            ),

        ]

        if method.get(

            "specimen_type"

        ):

            series_attributes.append(

                attr(

                    "Specimen Type",

                    method[

                        "specimen_type"

                    ],

                )

            )

        # Customer Requirement

        # je podle Rp0.2, Rm, A, Z

        # urcen primarne pro tensile.

        if (

            customer_requirement

            and series_key == "tensile"

        ):

            series_attributes.append(

                attr(

                    "Customer Requirement",

                    customer_requirement,

                    valuetype="string",

                )

            )

        # ====================================================

        # TEST SERIES OBJEKT

        # ====================================================

        objects.append(

            {

                "itemid":

                    series_id,

                "type":

                    "generic_test_series",

                "unique_fields_": [

                    "name"

                ],

                "toplevel_":

                    True,

                # TIMTO VZNIKNE

                # HIERARCHIE POD LAB ORDER

                "treetags": [

                    order_id

                ],

                "viewtags": [

                    "_generic"

                ],

                "name":

                    series_name,

                "attributes":

                    series_attributes,

                "link_id": [

                    f"dfe:"

                    f"{order_safe}:"

                    f"test_series"

                ],

                "pid":

                    order_id,

                "linkval": [

                    test_link

                ],

                "children": [

                    tests_table_id,

                    summary_id,

                ],

                "visible_":

                    "all",

                "permission_group":

                    "allreadonly",

                "version":

                    1,

                "view_id": [

                    series_id,

                    series_name,

                ],

            }

        )

        # ====================================================

        # TESTS LINKTABLE

        # ====================================================

        objects.append(

            create_linktable(

                tests_table_id,

                "Tests",

                "Tests",

                test_link,

                inherit="generic:tests",

            )

        )

        # ====================================================

        # TESTS SUMMARY

        # ====================================================

        objects.append(

            {

                "type":

                    "matoptimizer_forchildren",

                "property":

                    "Tests Summary",

                "child_":

                    True,

                "array": [],

                "sectags": [

                    "Tests"

                ],

                "target_spec": {

                    "link_id": {

                        "$in": [

                            test_link

                        ]

                    }

                },

                "visible_":

                    "all",

                "permission_group":

                    "allreadonly",

                "version":

                    1,

                "itemid":

                    summary_id,

                "view_id": [

                    summary_id

                ],

            }

        )

        # ====================================================

        # JEDNOTLIVE TESTY / SPECIMENY

        # ====================================================

        for (

            rank,

            row

        ) in enumerate(

            rows,

            start=1,

        ):

            specimen = str(

                row.get(

                    "Specimen",

                    f"specimen_{rank}",

                )

            )

            test_id = stable_id(

                f"{prefix}:"

                f"{series_key}:"

                f"test:{specimen}"

            )

            # =================================================

            # ATRIBUTY TESTU

            # =================================================

            test_attributes = [

                attr(

                    "Name",

                    specimen,

                ),

                # KLIKACI LAB ORDER

                attr(

                    "Lab Order",

                    order_number,

                    type="dblink",

                    linkkey="name",

                ),

                # KLIKACI TEST SERIES

                attr(

                    "Test Series",

                    series_name,

                    type="dblink",

                    linkkey="name",

                ),

            ]

            # =================================================

            # MERENE VELICINY

            # =================================================

            for (

                possible_keys,

                property_name,

                unit

            ) in TEST_FIELDS[

                series_key

            ]:

                exists, value = (

                    get_value(

                        row,

                        possible_keys,

                    )

                )

                if exists:

                    test_attributes.append(

                        attr(

                            property_name,

                            number_or_text(

                                value

                            ),

                            unit,

                        )

                    )

            # =================================================

            # TEST OBJEKT

            # =================================================

            objects.append(

                {

                    "itemid":

                        test_id,

                    "type":

                        "generic_test",

                    "unique_fields_": [

                        "name"

                    ],

                    "toplevel_":

                        True,

                    # TEST POD TEST SERIES

                    "treetags": [

                        series_id

                    ],

                    "viewtags": [

                        "_generic"

                    ],

                    "name":

                        specimen,

                    "attributes":

                        test_attributes,

                    "link_id": [

                        test_link,

                        f"dfe:"

                        f"{order_safe}:"

                        f"all_tests",

                    ],

                    "pid":

                        order_id,

                    "children":

                        [],

                    "visible_":

                        "all",

                    "permission_group":

                        "allreadonly",

                    "version":

                        1,

                    "view_id": [

                        test_id

                    ],

                    "ranks": {

                        order_id:

                            2.0,

                        series_id:

                            float(rank),

                    },

                }

            )

            test_count += 1

        created_series.append(

            series_key

        )

    # ========================================================

    # ULOZENI EDA JSONU

    # ========================================================

    output_path.write_text(

        json.dumps(

            objects,

            ensure_ascii=False,

            indent=2,

        ),

        encoding="utf-8",

    )

    return {

        "source":

            source_path.name,

        "output":

            output_path.name,

        "order":

            order_number,

        "reports":

            report_numbers,

        "pdfs":

            matched_pdfs,

        "missing_reports":

            missing_reports,

        "series":

            created_series,

        "tests":

            test_count,

        "objects":

            len(objects),

        "source_path": str(source_path),

        "output_path": str(output_path),

        "order_number": order_number,

        "report_numbers": report_numbers,

        "found_pdfs": matched_pdfs,

        "missing_pdfs": missing_reports,

        "created_test_series": created_series,

        "number_of_tests": test_count,

        "number_of_eda_objects": len(objects),

    }

