        print(f"CHYBA: Vstupní složka JSON neexistuje: {INPUT_DIR}")
        return

    source_files = sorted(INPUT_DIR.rglob("*.json"))
    pdf_files = sorted(PDF_DIR.rglob("*.pdf")) if PDF_DIR.exists() else []

    print(f"\nNalezeno JSON souborů: {len(source_files)}")
    for path in source_files:
        print(f"  JSON: {path}")

    print(f"\nNalezeno PDF souborů: {len(pdf_files)}")
    for path in pdf_files:
        print(f"  PDF : {path}")

    if not source_files:
        print("\nCHYBA: Nebyly nalezeny žádné JSON soubory. Konverze nebyla spuštěna.")
