def find_pdfs(

    report_number: str,

):

    if not PDF_DIR.exists():

        return []

    result = []

    # POZOR:

    # rglob = hleda i ve vsech podslozkach

    for pdf in PDF_DIR.rglob("*.pdf"):

        if pdf.name.upper().startswith(

            report_number.upper()

        ):

            result.append(

                pdf.name

            )

    return sorted(

        set(result)

    )

