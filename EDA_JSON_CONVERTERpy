        report = {
            "input_dir": str(INPUT_DIR),
            "pdf_dir": str(PDF_DIR),
            "input_json_count": 0,
            "pdf_count": len(pdf_files),
            "results": [],
            "errors": [{"source": None, "error": "Nebyly nalezeny žádné JSON soubory."}],
        }
        report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"Report: {report_path}")
        return

    results = []
    errors = []

    print("\n" + "-" * 72)
    print("START KONVERZE")
    print("-" * 72 + "\n")

    for source_path in source_files:
        try:
            output_path = OUTPUT_DIR / f"{source_path.stem}_EDA.json"
            result = convert_file(source_path, output_path)
            # Doplňující údaje pro auditní report; původní JSON se nemění.
            result["source_path"] = str(source_path)
            result["output_path"] = str(output_path)
            result["order_number"] = result.get("order", "")
            result["report_numbers"] = result.get("reports", [])
            result["found_pdfs"] = result.get("pdfs", [])
            result["missing_pdfs"] = result.get("missing_reports", [])
            result["created_test_series"] = result.get("series", [])
            result["number_of_tests"] = result.get("tests", 0)
            result["number_of_eda_objects"] = result.get("objects", 0)
            results.append(result)

            print(f"OK  {result['order']}")
            print("    Series: " + (", ".join(result["series"]) or "NONE"))
            print(f"    Tests : {result['tests']}")
            if result["pdfs"]:
                print("    PDFs:")
                for pdf_name in result["pdfs"]:
                    print(f"       + {pdf_name}")
            else:
                print("    PDFs: NONE")
            if result["missing_reports"]:
                print("    MISSING PDF FOR REPORT:")
                for report_number in result["missing_reports"]:
                    print(f"       ! {report_number}")
            print()

        except Exception as exc:
            error = {
                "source": source_path.name,
                "source_path": str(source_path),
                "error": str(exc),
            }
            errors.append(error)
            print(f"ERROR {source_path.name}")
            print(f"      {exc}")
            print()

    report_path = OUTPUT_DIR / "conversion_report.json"
    report = {
        "input_dir": str(INPUT_DIR),
        "pdf_dir": str(PDF_DIR),
        "output_dir": str(OUTPUT_DIR),
        "input_json_count": len(source_files),
        "pdf_count": len(pdf_files),
        "converted_count": len(results),
        "error_count": len(errors),
        "results": results,
        "errors": errors,
    }
    report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")

    print("=" * 72)
    print(f"Hotovo: {len(results)} JSONů")
    if errors:
        print(f"Chyby: {len(errors)}")
    print(f"Report: {report_path}")
    print("=" * 72)

if __name__ == "__main__":

    main()